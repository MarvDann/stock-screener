# Postgres (docker compose up -d gives you this one)
DATABASE_URL=postgres://stockwatch:stockwatch@localhost:5432/stockwatch

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-secret
# Where the app is opened; used for auth redirects and email links
APP_URL=http://localhost:5173
# Comma-separated emails allowed to sign up/sign in; unset allows anyone
ALLOWED_EMAILS=you@example.com

# Verification and password reset emails (printed to the console when unset)
RESEND_API_KEY=your_api_your_key
EMAIL_FROM=StockWatch <onboarding@resend.dev>

# Social sign-in (optional; each button appears once its pair is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
