{
  "name": "stockwatch",
  "version": "0.1.0",
  "description": "StockWatch: consolidation/breakout screener + sector rotation tracker",
  "main": "dist/server.js",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "concurrently -n api,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:client": "pnpm --dir client dev",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:backup": "tsx --env-file-if-exists=.env src/scripts/backupDb.ts",
    "db:export-seed": "tsx --env-file-if-exists=.env src/scripts/exportSeed.ts",
    "db:import-sqlite": "tsx --env-file-if-exists=.env src/scripts/importSqlite.ts"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "express": "5.2.1",
    "pg": "8.23.1",
    "yahoo-finance2": "4.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0"
}
